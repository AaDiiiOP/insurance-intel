# Local development only.
#
# docker-compose.yml already has working defaults for every value here, so
# this file is optional for a local run — copy it to .env only if you want
# to override something.
#
# For a SERVER deployment, do not use this file. Use docker-compose.prod.yml
# and set PUBLIC_URL and POSTGRES_PASSWORD in the shell instead; that compose
# file refuses to start without them rather than silently falling back to a
# local-dev password on a public box. See the README.

# Where the browser reaches the backend. Local dev only.
PUBLIC_API_URL=http://localhost:8100

# Origins the API accepts browser requests from, comma-separated.
CORS_ORIGINS=http://localhost:5183,http://localhost:3000

# Postgres. Fine as-is locally; never reuse these on a server.
POSTGRES_USER=insurance_user
POSTGRES_PASSWORD=insurance_pass
POSTGRES_DB=insurance_db

# Ollama, running on the host machine for local dev.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
